python3 - <<'PY'
from pathlib import Path

path = Path("scripts/translate-talmud-editor-v5.py")
text = path.read_text(encoding="utf-8")

old = '''def ensure_final(study: dict[str, Any], reference: str, original: str) -> list[str]:
    warnings: list[str] = []
    study["reference"] = reference
    study["texte_original"] = original
    for key in ("traduction_fidele", "traduction_fluide", "contexte_general", "synthese_finale"):
        if not isinstance(study.get(key), str) or not study[key].strip():
            warnings.append(f"Champ vide : {key}")
   for key in ("mot_a_mot", "mefarshim", "sources"):
    if not isinstance(study.get(key), list):
            warnings.append(f"Champ non conforme : {key}")
            study[key] = []
    study.setdefault("avertissements", [])
    for warning in warnings:
        if warning not in study["avertissements"]:
            study["avertissements"].append(warning)
    return warnings
'''

new = '''def ensure_final(study: dict[str, Any], reference: str, original: str) -> list[str]:
    warnings: list[str] = []

    study["reference"] = reference
    study["texte_original"] = original

    for key in (
        "traduction_fidele",
        "traduction_fluide",
        "contexte_general",
        "synthese_finale",
    ):
        if not isinstance(study.get(key), str) or not study[key].strip():
            warnings.append(f"Champ vide : {key}")

    for key in ("mot_a_mot", "mefarshim", "sources"):
        if not isinstance(study.get(key), list):
            warnings.append(f"Champ non conforme : {key}")
            study[key] = []

    study.pop("questions_revision", None)

    if not isinstance(study.get("avertissements"), list):
        study["avertissements"] = []

    for warning in warnings:
        if warning not in study["avertissements"]:
            study["avertissements"].append(warning)

    return warnings
'''

if old not in text:
    raise SystemExit(
        "❌ Le bloc endommagé n’a pas été trouvé exactement. "
        "Aucune modification n’a été effectuée."
    )

backup = path.with_suffix(path.suffix + ".before-fix.bak")
backup.write_text(text, encoding="utf-8")

path.write_text(text.replace(old, new, 1), encoding="utf-8")

print(f"✅ Fonction ensure_final réparée")
print(f"🛟 Sauvegarde : {backup}")
PY
